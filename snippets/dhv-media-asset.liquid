{%- comment -%}
  Renders the poster + video mount for one breakpoint of a Double Hero Video
  panel. Used twice per panel when a separate mobile asset is set (breakpoint
  "desktop" / "mobile"), or once with an empty breakpoint when there is only a
  single asset (shown on all breakpoints).

  Params:
    poster      - image (poster)
    video       - Shopify video object
    vimeo_link  - Vimeo URL string
    video_type  - 'shopify' | 'vimeo' | ''
    breakpoint  - 'desktop' | 'mobile' | '' (CSS hides the inactive one)
    loop        - boolean (native <video> loop attribute)
    sizes       - responsive image sizes attribute
{%- endcomment -%}
{%- if poster != blank -%}
  <div class="dhv__poster" data-dhv-poster data-breakpoint="{{ breakpoint }}">
    {%- render 'image', image: poster, sizes: sizes, cover: true -%}
  </div>
{%- endif -%}

{%- if video_type == 'shopify' -%}
  <div class="dhv__video-mount" data-dhv-video data-breakpoint="{{ breakpoint }}" data-video-type="shopify">
    {{ video | video_tag: image_size: '1500x', autoplay: false, loop: loop, muted: true, controls: false, preload: 'metadata' }}
  </div>
{%- elsif video_type == 'vimeo' -%}
  <div
    class="dhv__video-mount"
    data-dhv-video
    data-breakpoint="{{ breakpoint }}"
    data-video-type="vimeo"
    data-video-url="{{ vimeo_link | escape }}"
  ></div>
{%- endif -%}
