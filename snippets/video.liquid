{%- liquid
  assign block_settings = block_settings | default: section.settings
  assign block_element = block_element | default: false
  assign desktop_height = desktop_height | default: block_settings.desktop_height
  if request.visual_preview_mode
    assign desktop_height = ''
  endif
  assign mobile_height = mobile_height | default: block_settings.mobile_height
  assign video = block_settings.video
  assign video_social_link = block_settings.video_social_link | default: section.settings.video_social_link
  assign video_popup = block_settings.video_popup | default: block_settings.video_popup_social
  assign image_desktop = block_settings.image | default: video.preview_image
  assign image_mobile = block_settings.mobile_image
  assign text_color = block_settings.color
  assign overlay_opacity = block_settings.overlay_opacity | times: 0.01
  assign show_overlay_text = block_settings.show_overlay_text
  assign animation_anchor = '#Video--' | append: section.id

  assign title = block_settings.title
  assign text = block_settings.text
  assign link_text = block_settings.link_text
  assign link_text2 = block_settings.link_text2
  assign info_contact = block_settings.info_contact

  assign show_video_popup = false
  if block_settings.show_video_popup and video_popup != blank
    assign show_video_popup = true
  endif

  assign animation_order = 0
-%}

{%- capture style -%}
  {%- unless text_color.alpha == 0.0 or text_color == blank -%}
    --text: {{ text_color }};
  {%- endunless -%}
{%- endcapture -%}

{%- if block_settings.link != blank and link_text == blank -%}
  <a class="hero__video frame__item" href="{{ block_settings.link }}">
{%- else -%}
  <div class="hero__video frame__item">
{%- endif -%}

{%- liquid
  capture video_poster
    render 'image-hero', image_desktop: image_desktop, image_mobile: image_mobile, desktop_height: desktop_height, mobile_height: mobile_height, aspect_ratio: video.aspect_ratio, aspect_ratio_mobile: video.aspect_ratio
  endcapture
-%}

{%- if video != null -%}
  <div
    class="video-background {{ desktop_height }} {{ mobile_height }} wrapper-parent no-scroll"
    style="--aspect-ratio: {{ video.aspect_ratio | default: 1 }};"
  >
    <div class="video__poster">
      {{ video_poster }}
    </div>
    <video-background
      class="video__player is-loading"
      data-video-player
      data-video-id="{{ section.id }}-video-background"
    >
      <template data-video-template>
        {{ video | video_tag: autoplay: true, image_size: '1085x', loop: true, muted: true, controls: false }}
      </template>
    </video-background>
  </div>
{%- elsif video_social_link != blank -%}
  <div class="video-background {{ desktop_height }} {{ mobile_height }} wrapper-parent no-scroll" style="position: relative;">
    {% if section.settings.video_poster_image != blank %}
      <img id="video-poster-{{ section.id }}" src="{{ section.settings.video_poster_image | image_url: width: 1920 }}" alt="Video Poster" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:1;transition:opacity 0.5s;"> 
    {% else %}
      <img id="video-poster-{{ section.id }}" src="{{ 'SoilBackground.jpg' | asset_url }}" alt="Video Poster" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;z-index:1;transition:opacity 0.5s;"> 
    {% endif %}
    <iframe id="vimeo-iframe-{{ section.id }}" src="https://player.vimeo.com/video/{{ video_social_link | split: '/' | last }}?autoplay=1&muted=1&loop=1&background=1&title=0&byline=0&portrait=0&fullscreen=0" allow="autoplay; fullscreen; picture-in-picture"  frameBorder="0"></iframe>
  </div>
{%- else -%}
  {{ video_poster }}
{%- endif -%}

{%- unless show_overlay_text or overlay_opacity == 0.0 -%}
  <div class="image-overlay" style="--overlay-opacity: {{ overlay_opacity }};"></div>
{%- endunless -%}

{%- if block_settings.link != blank and link_text == blank -%}
  </a>
{%- else -%}
  </div>
{%- endif -%}

{%- if title != blank or text != blank or link_text != blank or show_video_popup -%}
  <div
    style="opacity: 0;"
    class="hero__content__wrapper wrapper frame__item"
    id="Video--{{ section.id }}"
  >
    <div
      class="hero__content wrapper-container"
      {% if overlay_opacity != 0.0 %}
        style="--overlay-opacity: {{ overlay_opacity }};"
      {% endif %}
    >
      {%- if title != blank -%}
        {%- liquid
          assign animation_order = animation_order | plus: 1
          assign heading_tag = 'h3'

          unless block_settings.heading_tag == 'automatic' or block_settings.heading_tag == blank
            assign heading_tag = block_settings.heading_tag
          endunless
        -%}
        <{{ heading_tag }}
          class="hero__title hero-title scroll-animate text-white fade-toggle show"
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="{{ animation_order }}"
        >
          {{ title }}
        </{{ heading_tag }}>
      {%- endif -%}

      {%- if text != blank -%}
        {%- assign animation_order = animation_order | plus: 1 -%}
        <div
          class="hero__description hero__title second-line-text scroll-animate text-white fade-toggle hide"
          data-aos="hero"
          data-aos-anchor="{{ animation_anchor }}"
          data-aos-order="{{ animation_order }}"
        >
          <h3 class="text-white">
            {{ text }}
          </h3>
        </div>
      {%- endif -%}

      {%- if link_text != blank or show_video_popup -%}
        <div class="hero__button-group">
          {%- if link_text != blank -%}
            {%- assign animation_order = animation_order | plus: 1 -%}
            <div
              class="hero__button"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              <a
                class="btn btn--primary"
                href="{{ block_settings.link }}"
              >
                <span>{{ link_text | escape }}</span>
                {%- render 'icon-arrow-right' -%}
              </a>
            </div>
          {%- endif -%}
          {%- if link_text2 != blank -%}
            <div
              class="hero__button"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              <a
                class="btn btn--primary"
                href="{{ block_settings.link_2 }}"
              >
                <span>{{ link_text2 | escape }}</span>
                {%- render 'icon-arrow-right' -%}
              </a>
            </div>
          {%- endif -%}

          {%- if info_contact != blank -%}
            <div class="info-contact">{{ info_contact }}</div> 
          {%- endif -%}

          {%- if show_video_popup -%}
            {%- liquid
              assign video_parent_id = 'item-video-' | append: section.id
              assign animation_order = animation_order | plus: 1
            -%}

            <video-popup
              class="hero__button"
              data-aos="hero"
              data-aos-anchor="{{ animation_anchor }}"
              data-aos-order="{{ animation_order }}"
            >
              <a
                href="{{ video_popup }}"
                class="btn image__video__play"
                data-video-play="{%- render 'photoswipe-video-html' item_link: video_popup, item_id: video_parent_id, item_enable_sound: 'false' -%}"
              >
                {% render 'icon-play' %}
              </a>
            </video-popup>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
