<style>
   .klaviyo-popup {
        position: fixed;
        top: 0;
        left: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1000;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .klaviyo-popup .popup-content {
        max-width: 500px;
        background: #fff;
        padding: 30px;
          position: relative;
    }
    .klaviyo-popup .close {
      position: absolute;
      top: 12px;
      right: 12px;
      cursor: pointer;
    }
     .klaviyo-popup .close svg {
        width: 20px;
        height: 20px;
    }

  @media only screen and (max-width:749px) {
    .klaviyo-popup .popup-content {
        width: 90%;
        padding: 16px;
    }
  }
</style>
{% endcomment %}

