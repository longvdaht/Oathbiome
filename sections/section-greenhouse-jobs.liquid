{{ 'section-greenhouse.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-greenhouse wrapper-container section-{{ section.id }}-padding">
  <div class="pl-50 pr-50">
    <div class="no-job-position">
      <div class="text-wrapper">
        {%- if section.settings.heading_empty != blank -%}
          <p class="title subhead-lg">{{ section.settings.heading_empty }}</p>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="description">{{ section.settings.description }}</p>
        {%- endif -%}
        {%- if section.settings.button_url != blank and section.settings.button_text != blank -%}
          <div class="button-wrapper">
            <a href="{{ section.settings.button_url }}" class="btn btn-icon btn-green" target="_blank">
              <span>{{ section.settings.button_text }}</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="job-opening">
      <div class="heading-content">
        {%- if section.settings.heading != blank -%}
          <h4 class="title subhead-lg">{{ section.settings.heading }}</h4>
        {%- endif -%}
      </div>
      <div class="job-wrapper" id="job-wrapper">
        
      </div>
      <script>
        (async () => {
          const boardToken = "oath64";
          const url = `https://boards-api.greenhouse.io/v1/boards/${boardToken}/jobs`;

          try {
            const res = await fetch(url);
            const data = await res.json();

            if (!data.jobs || data.jobs.length === 0) {
              document.querySelector('.section-greenhouse').classList.add('no-job');
              return;
            }

            let html = `<div class="job-list">`;
            data.jobs.forEach(job => {
              html += `
                <div class="job-card">
                  <div class="content-wrapper">
                    <div class="job-info">
                      <h3 class="job-title">${job.title}</h3>
                      ${job.location ? `<p class="location">${job.location.name}</p>` : ""}
                    </div>
                    <a href="${job.absolute_url}" target="_blank" rel="noopener" class="apply-btn btn btn-icon btn-green">
                      <span>Apply</span>
                    </a>
                  </div>
                </div>
              `;
            });
            html += `</div>`;

            document.getElementById("job-wrapper").innerHTML = html;
          } catch (err) {
            console.error("Error fetching jobs", err);
          }
        })();
      </script>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section Greenhouse",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "header",
      "content": "No open positions content"
    },
    {
      "type": "text",
      "id": "heading_empty",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Text",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top Desktop",
      "default": 30
    }, {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom Desktop",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Mobile",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Mobile",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Section Greenhouse"
    }
  ]
}
{% endschema %}