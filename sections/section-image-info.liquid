{{ 'section-image-info.css' | asset_url | stylesheet_tag }}

{% style %}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    padding-left: var(--outer);
    padding-right: var(--outer);
  }

  .section-{{ section.id }}
  .image-info__container {
    padding-top: {{ section.settings.mobile_content_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_content_padding_bottom }}px;
    padding-left: {{ section.settings.mobile_content_padding_left }}px;
    padding-right: {{ section.settings.mobile_content_padding_right }}px;
    background-color: {{ section.settings.background_color }};
  }

  .section-{{ section.id }} .image__container {
    display: flex;
    flex-direction: {% if section.settings.mobile_image_position == 'horizontal' %}row{% else %}column{% endif %};
  }

  @media (min-width: 990px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}
    .image-info__container {
      padding-top: {{ section.settings.content_padding_top }}px;
      padding-bottom: {{ section.settings.content_padding_bottom }}px;
      padding-left: {{ section.settings.content_padding_left }}px;
      padding-right: {{ section.settings.content_padding_right }}px;
    }

    .section-{{ section.id }} .image__container {
      display: flex;
      flex-direction: row;
    }
  }

  @media (max-width: 989px) {
    {% if section.settings.mobile_image_position == 'horizontal' %} 
      .section-{{ section.id }} .image__container {
        justify-content: center;
        gap: 30px;
      }
    {% else %}
      .section-{{ section.id }} .image__container {
        justify-content: center;
        gap: 35px;
      }
    {% endif %}
  }

  {%  for block in section.blocks %}
    {% if block.type == 'image' %}
      {% if block.settings.image_divider %}
        .block-{{ block.id }} .image-info__image--container::after {
          content: '';
          position: absolute;
          bottom: 2px;
          left: 50%;
          width: 1px;
          height: {{ block.settings.mobile_divider_width }}px;
          background-color: var(--color-brown);
          margin: 0 auto;
        }

        @media (min-width: 990px) {
          .block-{{ block.id }} .image-info__image--container::after {
            width: {{ block.settings.divider_width }}px;
            height: 1px;
            top: 50%;
            right: 2px;
            bottom: unset;
            left: unset;
          }
        }
      {% endif %}
    {% endif %}  
  {% endfor %}
{% endstyle %}

<div class="section-{{ section.id }} image-info wrapper">
  <div class="image-info__container">
    {% if section.blocks.size > 0 %}
      <div class="image__container">
        {% for block in section.blocks %}
          {% if block.type == 'image' %}
            <div class="image-info__item block-{{ block.id }}">
              <div class="image-info__image--description">
                {% if block.settings.description != blank %}
                  <p class="body-small image-info__image-description">{{ block.settings.description }}</p>
                {% endif %}
                {% if block.settings.image != blank %}
                  <div class="image-info__image--container">
                    <img src="{{ block.settings.image |  image_url: width: 800 }}" alt="{{ block.settings.title }}">
                  </div>
                {% endif %}
                {% if block.settings.title != blank %}
                  <p class="body-small image-info__image-title mobile-show large-hide">{{ block.settings.title }}</p>
                {% endif %}
              </div>
              {% if block.settings.title != blank %}
                <p class="body-small image-info__image-title mobile-hide large-show">{{ block.settings.title }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="content__container">
        {% for block in section.blocks %}
          {% if block.type == 'text' %}
            <div class="content__item">
              {% if block.settings.heading %}
                <p class="{{ block.settings.desktop_heading_size }} content__item--heading mobile-hide large-show">{{ block.settings.heading }}</p>
                <p class="{{ block.settings.mobile_heading_size }} content__item--heading mobile-show large-hide">{{ block.settings.heading }}</p>
              {% endif %}
              {% if block.settings.description %}
                <p class="{{ block.settings.desktop_description_size }} content__item--description mobile-hide large-show">{{ block.settings.description }}</p>
                <p class="{{ block.settings.mobile_description_size }} content__item--description mobile-show large-hide">{{ block.settings.description }}</p>
              {% endif %}
              {% if block.settings.email_url != blank %}
                <a class="content__item--mail btn btn--secondary" href="mailto:{{ block.settings.email_url }}">{{ block.settings.email_url }}</a>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sections = document.querySelectorAll('.section-{{ section.id }}');

    sections.forEach((section) => {
      const descriptions = section.querySelectorAll('.image-info__image-description');
      const imageItems = section.querySelectorAll('.image-info__item');

      if (imageItems.length === 0) return;

      section.querySelectorAll('.image-info__image-title').forEach((title) => {
        const img = title.closest('.image-info__item').querySelector('img');
        if (descriptions.length > 0) {
          imageItems.forEach((item) => {
            item.classList.add('justify-right');
          });

          if (img && img.complete) {
            title.style.width = `${img.offsetWidth}px`;
            title.style.textAlign = 'center';
          }
        } else {
          imageItems.forEach((item) => {
            item.classList.add('justify-center');
          });
        }
      });
    })
  });
</script>

