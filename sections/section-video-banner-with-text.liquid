    {
      "type": "range",
      "id": "typo_mobile_padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Typography Mobile Padding Left",
      "default": 0
    },
    {
      "type": "range",
      "id": "typo_mobile_padding_right",
      "min": 0,
      "max": 100,
