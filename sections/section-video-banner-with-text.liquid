    {
      "type": "header",
      "content": "Typography Spacing"
    },
    {
      "type": "range",
      "id": "typo_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Typography Padding Top",
