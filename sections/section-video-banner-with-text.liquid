{{ 'section-video-banner-with-text.css' | asset_url | stylesheet_tag }}
<!-- /sections/section-hero.liquid -->

{%- liquid
  assign video = section.settings.video
  assign image_desktop = section.settings.image | default: video.preview_image
  assign image_mobile = section.settings.mobile_image

  assign title1 = section.settings.title
  assign title2 = section.settings.title_2
  assign text = section.settings.description
  assign link_text = section.settings.link_text
  assign link = section.settings.link
-%}

{%- if section.settings.video != null -%}
  <script src="{{ 'video-background.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% style %}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .section-video__content--text {
    background-color: {{ section.settings.typo_background }};
    padding: {{ section.settings.typo_mobile_padding_top }}px {{ section.settings.typo_mobile_padding_right }}px {{ section.settings.typo_mobile_padding_bottom }}px {{ section.settings.typo_mobile_padding_left }}px;
  }
  
  @media (min-width: 990px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }} .section-video__content--text {
      padding: {{ section.settings.typo_padding_top }}px {{ section.settings.typo_padding_right }}px {{ section.settings.typo_padding_bottom }}px {{ section.settings.typo_padding_left }}px;
    }
  }
{% endstyle %}

<div
  class="section-video-banner wrapper section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="featured-video"
  data-overlay-header
>
  <div class="section-video__container">
    {%- liquid
      capture video_poster
        render 'image-hero', image_desktop: image_desktop, image_mobile: image_mobile, desktop_height: 1000, mobile_height: 500, aspect_ratio: video.aspect_ratio, aspect_ratio_mobile: video.aspect_ratio
      endcapture
    -%}

    {%- if video != null -%}
      <div
        class="section-video__banner video-background"
        style="--aspect-ratio: {{ video.aspect_ratio | default: 1 }};"
      >
        <div class="video__poster">
          {{ video_poster }}
        </div>
        <video-background
          class="video__player is-loading"
          data-video-player
          data-video-id="{{ section.id }}-video-background"
        >
          <template data-video-template>
            {{ video | video_tag: autoplay: true, image_size: '1085x', loop: true, muted: true, controls: false }}
          </template>
        </video-background>
      </div>
    {%- else -%}
      {{ video_poster }}
    {%- endif -%}
    {% if video or video_poster %}
      <div class="section-video__content--wrapper {{ section.settings.content_position }}">
        <div class="section-video__content--text">
          <div class="section-video__content--title">
            {% if title1 %}<h4>{{ title1 }}</h4>{% endif %}
            {% if title2 %}<h4>{{ title2 }}</h4>{% endif %}
          </div>
          <div class="section-video__content--button">
            {% if text %}<p class="body-large section-video__description">{{ text }}</p>{% endif %}
            {%- if link_text and link -%}
              <a href="{{ link }}" class="btn btn--secondary btn--content">
                {{ link_text }} 
                {%- render 'icon-arrow-right' -%}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
