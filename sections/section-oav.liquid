{{ 'section-oav.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  @media screen and (min-width: 901px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="wrapper-container section-{{ section.id }}-padding section-oav">
  <div class="oav-main">
    {%- for block in section.blocks -%}
      <div class="oav-item" style="background-color: {{ section.settings.background_color }};">
        <div class="oav-item__left">
          <div class="oav-subtitle" style="color: {{ section.settings.text_color }};">
            {{ block.settings.subtitle }}
          </div>
          <div class="oav-title">
            <h3 style="color: {{ section.settings.text_color }};">{{ block.settings.title }}</h3>
          </div>
        </div>
        <div class="oav-item__right">
          <div class="oav-content" style="color: {{ section.settings.text_color }};">
            {{ block.settings.content }}
          </div>
          <div class="oav-action">
            <button href="{{ block.settings.button_url }}" class="btn btn-icon btn-gray-blur"><span>{{ block.settings.button_text }}</span></button>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.section-oav .oav-action button').forEach(button => {
    button.addEventListener('click', () => {
      const targetSection = document.querySelector('.ob-newsletter');
      if (targetSection) {
        const topPos = targetSection.getBoundingClientRect().top + window.pageYOffset;
        window.scrollTo({ top: topPos - 80, behavior: 'smooth' });
      }
    });
  });
});
</script>
{% schema %}
  {
    "name": "Section OAV",
    "class": "section-oav",
    "settings": [
      {
        "type": "header",
        "content": "Section Style"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 20
      }, 
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "mobile_padding_top",
        "label": "Mobile Padding Top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "range",
        "id": "mobile_padding_bottom",
        "label": "Mobile Padding Bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 20
      },
      {
        "type": "header",
        "content": "Section Color text"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#103228"
      }, 
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#fff"
      }
    ],
    "blocks": [
      {
        "type": "oav-item",
        "name": "OAV item",
        "settings": [
          {
            "type": "select",
            "id": "image_align",
            "label": "Image align",
            "options": [
              {
                "value": "left",
                "label": "Align left"
              },
              {
                "value": "right",
                "label": "Align right"
              }
            ]
          },
          {
            "type": "text",
            "id": "subtitle",
            "label": "subtitle",
            "default": "OAV-1"
          },
          {
            "type": "text",
            "id": "title",
            "label": "title"
          },
          {
            "type": "richtext",
            "id": "content",
            "label": "content",
          },
          {
            "type": "text",
            "id": "button_text",
            "label": "Button text",
            "default": "Get Involved"
          },
          {
            "type": "url",
            "id": "button_url",
            "label": "Button Url"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Section OAV",
        "category": "Custom"
      }
    ]
  }
{% endschema %}