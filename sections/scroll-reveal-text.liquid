{%- assign is_static = section.settings.disable_js_scroll -%}

{{ 'scroll-reveal-text.css' | asset_url | stylesheet_tag }}
{%- unless is_static -%}
  <script src="{{ 'scroll-reveal-text.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{% style %}
  .section-scroll-reveal[data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .section-scroll-reveal[data-section-id="{{ section.id }}"] {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="section-scroll-reveal{% if is_static %} is-static{% endif %}" data-section-id="{{ section.id }}">
  <div class="scroll-reveal__content__wrapper wrapper-container pl-165 pr-50 scroll-animate fade-toggle aos-animate{% unless is_static %} hide{% endunless %}" data-aos-duration="100">
    {% for block in section.blocks %}
      <div class="scroll-reveal-line rte{% unless is_static %}{% if forloop.first %} show{% else %} hide{% endif %}{% endunless %} scroll-animate fade-toggle aos-animate
        {% if section.settings.text_white %} text-white{% endif %}
        {% if block.settings.use_big_text %} big-text{% endif %}"
          data-index="{{ forloop.index0 }}"
          data-aos="hero">
        {{ block.settings.text }}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Scroll reveal text",
  "settings": [
    {
      "type": "checkbox",
      "id": "disable_js_scroll",
      "label": "Disable JS scroll",
      "info": "Show all text blocks at once instead of revealing them on scroll.",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "checkbox",
      "id": "text_white",
      "label": "Text white"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Top Desktop",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Bottom Desktop",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top Mobile",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom Mobile",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "text_item",
      "name": "Text block",
      "settings": [
        {
          "type": "checkbox",
          "id": "use_big_text",
          "label": "Use big text",
          "default": true
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Oath Biome returns diverse communities of essential microbial life to global soils.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Scroll reveal text",
      "blocks": [
        { "type": "text_item" },
        { "type": "text_item" }
      ]
    }
  ]
}
{% endschema %}
