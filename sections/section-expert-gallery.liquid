{{ 'section-expert-gallery.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  if section.blocks.size == 3
    if section.settings.full_width_layout
      assign full_width = 'full-width-3-items'
    endif
  endif
-%}

{%- style -%}
  #Rte--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="Rte--{{ section.id }}"
  class="index-rte expert-gallery section-padding {{ color_scheme }} pl-50 pr-50"
  data-section-id="{{ section.id }}"
  data-section-type="expert-gallery"
>
  <div class="wrappers content-wrapper">
    {% if section.settings.heading != blank %}
      <h5 class="heading">{{ section.settings.heading }}</h5>
    {%- endif -%}
    {% assign block_count = section.blocks.size %}
    <div class="expert-wrapper {% if block_count > 2 %}
        grid-4-items
      {% else %}
        grid-{{ block_count }}-items
      {% endif %} {{ full_width }}">
      {%- for block in section.blocks -%}
        <div class="expert-person item">
          {% if block.settings.image != blank %}
            <div class="person-avatar">
              {%- render 'image', image: block.settings.image -%}
            </div>
          {%- endif -%}
          <div class="person-information">
            {% if block.settings.title != blank %}
              <h6 class="title">{{ block.settings.title }}</h6>
            {%- endif -%}
            {% if block.settings.infor != blank %}
              {{ block.settings.infor }}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const expertGalleries = document.querySelectorAll('.content-wrapper .expert-wrapper');
    const flktyInstances = new WeakMap();

    function initFlickityIfNeeded() {
      if (window.innerWidth < 749) {
        expertGalleries.forEach(widget => {
          if (!flktyInstances.has(widget)) {
            const flkty = new window.theme.Flickity(widget, {
              cellAlign: 'left',
              contain: true,
              wrapAround: false,
              pageDots: true,
              prevNextButtons: false,
              draggable: true,
              freeScroll: false,
              groupCells: false,
              initialIndex: 0,
              autoPlay: false,
              adaptiveHeight: false,
              percentPosition: true,
              dragThreshold: 30,
            });
            flktyInstances.set(widget, flkty);
          }
        });
      } else {
        expertGalleries.forEach(widget => {
          if (flktyInstances.has(widget)) {
            const flkty = flktyInstances.get(widget);
            flkty.destroy();
            flktyInstances.delete(widget);
          }
        });
      }
    }

    initFlickityIfNeeded();

    let resizeTimeout;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(initFlickityIfNeeded, 200);
    });
  });
</script>

{% schema %}
  {
    "name": "Expert gallery",
    "class": "expert-gallery wrapper-container",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "default": "scheme_1",
        "label": "Color scheme"
      },
      {
        "type": "checkbox",
        "id": "full_width_layout",
        "default": false,
        "label": "Show 3 items full width"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "header",
        "content": "Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Top",
        "default": 100
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Bottom",
        "default": 100
      }
    ],
    "blocks": [
      {
        "type": "expert",
        "name": "Expert",
        "limit": 10,
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Heading",
            "default": "Rich text"
          },
          {
            "type": "richtext",
            "id": "infor",
            "label": "Information"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Expert gallery"
      }
    ],
    "disabled_on": {
      "groups": ["header", "aside", "footer"]
    }
  }
{% endschema %}