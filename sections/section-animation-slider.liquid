      },
      {
        "type": "header",
        "content": "Mobile intro heading content"
      },
      {
        "type": "text",
        "id": "mobile_heading",
        "label": "Mobile Heading",
        "default": "Soil microbes evolved 1 billion years ago. Without them, there would be no plants."
      },
      { 
        "type": "textarea",
        "id": "description",
        "label": "Description",
        "default": "We sequence the genome of each microbe to identify beneficial functions (e.g., enzymatic capacity to degrade plant litter, nitrogen fixation, drought tolerance)."
      },
      {
        "type": "header",
        "content": "Section Color Settings"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background Color",
        "default": "#301912"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "counter_text_color",
        "label": "Counter Text Color",
        "default": "#a39280"
      },
      {
        "type": "color",
        "id": "counter_active_text_color",
        "label": "Counter Active Text Color/Mobile Indicator Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "counter_hover_text_color",
        "label": "Counter Hover Text Color",
        "default": "#a39280"
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "Padding Top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "Padding Bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "mobile_padding_top",
        "label": "Mobile Padding Top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 0
      },
      {
        "type": "range",
        "id": "mobile_padding_bottom",
        "label": "Mobile Padding Bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "block",
        "name": "Animation Block",
        "settings": [
          {
            "type": "header",
            "content": "Content"
          },
          {
            "type": "select",
            "id": "slide_type",
            "label": "Slide Type",
            "default": "regular",
            "options": [
              {
                "value": "intro",
                "label": "Intro Slide"
              },
              {
                "value": "regular",
                "label": "Regular Slide"
              }
            ]
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Sub Heading",
            "default": "Oath Microbial Discovery Engine"
          },
          {
            "type": "text",
            "id": "heading",
            "label": "Heading",
            "default": "Soil microbes evolved 1 billion years ago. Without them, there would be no plants."
          },
          {
            "type": "text",
            "id": "mobile_heading",
            "label": "Mobile Heading",
            "default": "Default Mobile Heading"
          },
          { 
            "type": "textarea",
            "id": "description",
            "label": "Description",
            "default": "380 million years ago, plants developed roots in the soil and co-evolved functional relationships with the microbes surrounding their roots to enhance each other’s ability to survive storms, droughts, floods, fires, and freezes."
          },
          {
            "type": "header",
            "content": "Video"
          },
          {
            "type": "image_picker",
            "id": "custom_image",
            "label": "Custom Image",
            "info": "Slide intro Image takes priotity over video on mobile"
          },
          {
            "type": "video",
            "id": "video_url",
            "label": "MP4 Video URL (Takes Priority Over Image)"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Section Animation Slider",
        "category": "Custom",
        "blocks": [
          {
            "type": "block"
          },
          {
            "type": "block"
          },
          {
            "type": "block"
          }
        ]
      }
    ]
  }
  {% endschema %}