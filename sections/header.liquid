{% render 'header', header_style: 'logo_beside' %}
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const intervalHeader = setInterval(() => {
      const header = document.querySelector('header');
      const getInTouchSection = document.querySelector('.shopify-section.ob-newsletter');
      const footerSection = document.querySelector('.group-footer');
      const banner = document.querySelector('.section-hero-banner .frame');
      const parentBanner = banner ? banner.closest('.section-hero-banner') : null;

      if (header && footerSection) {
        const headerWrapper = header.closest('.header__wrapper');
        const bannerBottom = banner ? banner.getBoundingClientRect().bottom + window.scrollY : 0;

        // Debounce utility to limit scroll event frequency
        const debounce = (func, wait = 100) => {
          let timeout;
          return function (...args) {
            clearTimeout(timeout);
            timeout = setTimeout(() => func.apply(this, args), wait);
          };
        }

        // Throttle utility
        const throttle = (func, limit = 50) => {
          let inThrottle;
          return function(...args) {
            if (!inThrottle) {
              func.apply(this, args);
              inThrottle = true;
              setTimeout(() => inThrottle = false, limit);
            }
          };
        };

        const bannerSection = document.querySelector('.section-hero-banner');
        const bannerShopifySection = bannerSection ? bannerSection.closest('.shopify-section') : null;
        let nextSection = null;
        if (bannerShopifySection) {
          nextSection = bannerShopifySection.nextElementSibling;
          while (nextSection && !nextSection.classList.contains('shopify-section')) {
            nextSection = nextSection.nextElementSibling;
          }
        }

        const handleScroll = throttle(() => {
          const scrollPosition = window.scrollY || window.pageYOffset;
          const headerHeight = header.offsetHeight || 113;

          if (nextSection) {
            const nextSectionTop = nextSection.getBoundingClientRect().top + window.scrollY;
            if (scrollPosition >= nextSectionTop - headerHeight) {
              headerWrapper.classList.add('over-past-banner');
              headerWrapper.classList.remove('scroll-past-banner');
            } else {
              headerWrapper.classList.remove('over-past-banner');
              headerWrapper.classList.add('scroll-past-banner');
            }
          }

          // Footer and Get In Touch visibility
          const isFooterVisible = footerSection.getBoundingClientRect().top <= window.innerHeight * 0.25 &&
                                  footerSection.getBoundingClientRect().bottom >= window.innerHeight * 0.25;

          const isGetInTouchVisible = getInTouchSection &&
                                      getInTouchSection.getBoundingClientRect().top <= window.innerHeight * 0.25 &&
                                      getInTouchSection.getBoundingClientRect().bottom >= window.innerHeight * 0.25;

          if (isFooterVisible || isGetInTouchVisible) {
            headerWrapper.classList.add('hidden-header');
          } else {
            headerWrapper.classList.remove('hidden-header');
          }
        }, 50);

        window.addEventListener('scroll', handleScroll);

        clearInterval(intervalHeader);
      }
    }, 100);
  });
</script>
