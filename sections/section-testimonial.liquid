{{ 'section-testimonial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-testimonial.js' | asset_url }}" defer="defer"></script>

{% style %}
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  {% for block in section.blocks %}
    .section-{{ section.id }}.section-testimonial .block-{{ block.id }} {
      background-color: {{ block.settings.background_color }};
    }

    .section-{{ section.id }}.section-testimonial .block-{{ block.id }} {
      color: {{ block.settings.text_color }};
    }

    .section-{{ section.id }} .block-{{ block.id }} {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
      padding-left: {{ block.settings.mobile_padding_left }}px;
      padding-right: {{ block.settings.mobile_padding_right }}px;
    }

    .section-{{ section.id }} .block-{{ block.id }} .testimonial__text {
      order: {% if block.settings.mobile_switch_content %}-1{% else %}0{% endif %};
    }

    .section-{{ section.id }} .block-{{ block.id }}.section-testimonial__item {
        gap: {{ block.settings.mobile_content_gap }}px;
      }

    @media (min-width: 750px) {
      .section-{{ section.id }} .block-{{ block.id }} {
        padding-top: {{ block.settings.padding_top }}px;
        padding-bottom: {{ block.settings.padding_bottom }}px;
        padding-left: {{ block.settings.padding_left }}px;
        padding-right: {{ block.settings.padding_right }}px;
      }
      
      .section-{{ section.id }} .block-{{ block.id }} .testimonial__text {
        order: {% if block.settings.switch_content %}-1{% else %}0{% endif %};
      }

      .section-{{ section.id }} .block-{{ block.id }}.section-testimonial__item {
        gap: {{ block.settings.content_gap }}px;
      }
    }
  {% endfor %}

  @media (min-width: 750px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}

<div class="section-{{ section.id }} section-testimonial">
  <div class="section-testimonial__container only-block"
    data-show-buttons="{{ section.settings.show_carousel_buttons }}"
    data-autoplay="{{ section.settings.carousel_autoplay }}"
    data-autoplay-speed="{{ section.settings.carosel_autoplay_speed }}"
  >
    {% for block in section.blocks %}
      <div class="section-testimonial__item block-{{ block.id }}">
        {% if block.settings.testimonial_text and block.settings.testimonial_text_size %}
          <{{ block.settings.testimonial_text_size }} class="section-testimonial__title">{{ block.settings.testimonial_text }}</{{ block.settings.testimonial_text_size }}>
        {% endif %}

        <div class="section-testimonial__information">
          <div class="section-testimonial__image">
            {% if block.settings.testimonial_image %}
              <img src="{{ block.settings.testimonial_image | img_url: '300x300' }}" alt="{{ block.settings.testimonial_image.alt }}">
            {% endif %}
          </div>
          <div class="testimonial__text details-large">
            {% if block.settings.testimonial_author %}
              <p>{{ block.settings.testimonial_author }},&nbsp;</p>
            {% endif %}
            {% if block.settings.testimonial_company %}
              <p class="italic">{{ block.settings.testimonial_company }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<script>
  
</script>

