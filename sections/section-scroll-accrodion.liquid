
<script src="{{ 'accordion-scroll.js' | asset_url }}" defer="defer"></script>
{{ 'accordion-scroll.css' | asset_url | stylesheet_tag }}

<div class="scroll-section  wrapper-container" id="wrapper">
  <div id="content">
    <div class="accordions">
      {% for block in section.blocks %}
        <div class="accordion{% if forloop.last %} last{% endif %}">
          <div class="content-wrapper">
             <div class="content-text">
              {% if block.settings.title != blank %}
                <h4>{{ block.settings.title }}</h4>
              {% endif %}
              {% if block.settings.text != blank %}
              <div class="content-scroll">
                <p class="body-x-large">{{ block.settings.text }}</p>
              </div>
              {% endif %}
            </div>
            <div class="content-media {% if block.settings.use_video %}use-video{% endif %}">
              <div class="img-video">
              {% if block.settings.use_video %}
                {% assign video_type = '' %}
                {% assign video_src = '' %}
                
                {% if block.settings.normal_video != blank %}
                  {% assign video_type = 'mp4' %}
                  {% assign video_src = block.settings.normal_video.sources[1].url %}
                {% elsif block.settings.video_url != blank %}
                  {% assign video_type = 'youtube' %}
                  {% assign video_src = block.settings.video_url | escape %}

                  {% assign video_url = block.settings.video_url %}
                  {% assign video_id = '' %}
                  {% if video_url contains 'v=' %}
                    {% assign video_id = video_url | split: 'v=' | last | split: '&' | first %}
                  {% else %}
                    {% assign video_id = video_url | split: '/' | last %}
                  {% endif %}
                {% endif %}

                {% if video_type == 'mp4' and video_src != blank %}
                  <video
                    class="video-autoplay"
                    src="{{ video_src }}"
                    autoplay
                    muted
                    playsinline
                    loop
                    preload="auto"
                    style="width: 100%; height: 100%;"
                  ></video>
                {% elsif video_type == 'youtube' and video_id != blank %}
                  <div class="video-slider__item block-{{ block.id }}">
                    <div class="video-slider__thumb">
                      <img
                        class="video-slider__img"
                        src="https://img.youtube.com/vi/{{ video_id }}/hqdefault.jpg"
                        alt="{{ block.settings.title | escape }}"
                        loading="lazy"
                      >
                      <div
                        class="video-thumbnail open-video-popup"
                        onclick="openCustomVideoPopup({ type: 'youtube', src: '{{ video_src }}' })"
                      >
                        {% render 'play-button' %}
                      </div>
                    </div>
                  </div>
                {% endif %}
              {% else %}
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | img_url: 'large' }}">
                {% endif %}
              {% endif %}
              </div>
            </div>
          </div>      
        </div>
      {% endfor %}
    </div>
  </div>
</div>
<div class="spacer-after-scroll wrapper-container"></div>

{% schema %}
{
  "name": "Scroll Section",
  "tag": "section",
  "class": "accordion-scroll-section",
  "settings": [
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Accordion Title",
          "default": "Accordion Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Accordion Content",
          "default": "Accordion content goes here."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "checkbox",
          "id": "use_video",
          "label": "Use video instead of image",
          "default": false
        },
        {
          "type": "header",
          "content": "Video Settings",
          "info": "Only one popup option can be used at a time."
        },
        {
          "type": "video",
          "id": "normal_video",
          "label": "MP4/MOV"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "Youtube link",
          "default": "https://www.youtube.com/watch?v=_9VUPq3SxOc",
          "accept": ["youtube"]
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "Thumbnail"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Scroll Section",
      "category": "Custom"
    }
  ]
}
{% endschema %}