{{ 'text-cta-grid.css' | asset_url | stylesheet_tag }}

<div
  class="section text-cta-grid"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --padding-top-mobile: {{ section.settings.padding_top_mobile }}px; --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;"
>
  <div class="wrapper-container">
    <div class="text-cta-grid__content">
      <div class="text-cta-grid__items">
        {% for block in section.blocks %}
          <div class="text-cta-grid__item">
            <h4 class="text-cta-grid__title">{{ block.settings.cta_title }}</h4>
            <div class="text-cta-grid__button">
              <a
                {% if block.settings.button_url == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.button_url }}"
                {% endif %}
                class="btn btn-icon btn-light-gray"
              >
                <span>{{- block.settings.button_text -}}</span>
              </a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Text CTA Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top padding on mobile",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom padding on mobile",
      "default": 18
    }
  ],
  "blocks": [
    {
      "type": "text_cta",
      "name": "Text CTA",
      "settings": [
        {
          "type": "text",
          "id": "cta_title",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text CTA Grid",
      "category": "Text",
      "blocks": [
        {
          "type": "text_cta"
        },
        {
          "type": "text_cta"
        },
        {
          "type": "text_cta"
        }
      ]
    }
  ]
}
{% endschema %}
