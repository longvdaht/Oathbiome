{{ 'section-dark-callout.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  {% if section.settings.background_image %}
    .dark-callout-hero.position-left:before {
      background-image: url({{ section.settings.background_image | img_url: '1200x' }});"
      background-size: cover;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="section-dark-callout wrapper-container section-{{ section.id }}-padding">
  <div
    class="dark-callout-hero position-{{ section.settings.section-position }} section-{{ section.settings.container-position }}"
    style="background-image: url({{ section.settings.background_image | img_url: '1200x' }});">
    <div class="dark-callout-content">
      {%- if section.settings.heading != blank -%}  
        <h3>{{ section.settings.heading }}</h3>
      {%- endif -%}
      <div class="dark-callout-actions">
        {%- if section.settings.button_text != blank -%}
          {% if section.settings.video_social_link %}
            {% assign video_src = '' %}
            {% assign video_src = section.settings.video_social_link %}
            <div class="video-thumbnail open-video-popup" 
              data-block-id="{{ section.id }}"
              data-video-src="{{ video_src | base64_encode }}"
              data-video-type="{{  section.settings.video_social_link.type }}"
            >
              <button class="btn btn-icon btn-play-white"><span>{{ section.settings.button_text }}</span></button>
            </div>
          {% elsif section.settings.video %}
            {% assign video_src = '' %}
            {% assign last_source = section.settings.video.sources | last %}
            {% assign video_src = last_source.url %}
            <div
              class="video-thumbnail open-video-popup"
              data-block-id="{{ section.id }}"
              data-video-type="mp4"
              data-video-src="{{ video_src | base64_encode }}"
            >
              <button class="btn btn-icon btn-play-white"><span>{{ section.settings.button_text }}</span></button>
            </div>
          {% endif %}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Dark Callout Hero",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image"
      },
      {
        "type": "video",
        "id": "video",
        "label": "Video upload",
      },
      {
        "type": "video_url",
        "id": "video_social_link",
        "accept": ["youtube", "vimeo"],
        "label": "Video URL"
      },
      {
        "type": "select",
        "id": "section-position",
        "label": "Section Position",
        "options": [
          {
            "value": "left",
            "label": "Left"
          }, {
            "value": "center",
            "label": "Center"
          }, {
            "value": "right",
            "label": "Right"
          }
        ],
        "default": "left"
      },
      {
        "type": "text",
        "id": "button_text",
        "label": "Button Text"
      },
      {
        "type": "header",
        "content": "Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Top Desktop",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 200,
        "step": 2,
        "unit": "px",
        "label": "Bottom Desktop",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_top_mobile",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Top Mobile",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom_mobile",
        "min": 0,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "Bottom Mobile",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Dark Callout Hero",
        "category": "Custom"
      }
    ]
  }
{% endschema %}