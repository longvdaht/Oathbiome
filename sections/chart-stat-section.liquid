          "default": "<p>Visual test of turfgrass quality by the National Turfgrass Evaluation Program. Quality ranges from 1 (poor or dead) to 9 (perfect).</p>"
        },
        {
          "type": "textarea",
          "id": "person",
          "label": "Person",
          "default": "Dr. Mohammad Pessarakli, University of Arizona"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "number",
          "id": "min_number",
          "label": "Minimum Number",
          "default": 0
        },
        {
          "type": "number",
          "id": "max_number",
